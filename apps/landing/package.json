{
  "name": "@sergeant/landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3100 --host 0.0.0.0",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/postbuild-seo.mjs && node scripts/prerender.mjs",
    "preview": "vite preview --port 3100",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "shots": "node scripts/shot-pages.mjs",
    "verify:browser": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/unbounded": "^5.2.5",
    "@sergeant/shared": "workspace:*",
    "posthog-js": "^1.399.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@sergeant/design-tokens": "workspace:*",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
