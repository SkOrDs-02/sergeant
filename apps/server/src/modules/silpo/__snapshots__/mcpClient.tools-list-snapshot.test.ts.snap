            "description": "Branch ID from silpo_get_shopping_cart_by_id",
            "type": "string",
          },
          "deliveryType": {
            "description": "Delivery type from silpo_get_shopping_cart_by_id",
            "enum": [
              "Unknown",
              "SelfPickup",
              "DeliveryHome",
              "DeliveryFlat",
              "DeliveryOffice",
              "DeliveryGlovo",
              "DeliveryExpress",
              "DeliveryExpressFood",
              "JustIn",
              "LongDelivery",
              "JustInPost",
              "NovaPoshta",
              "DeliveryExpressByPromise",
              "WideAssortDelivery",
            ],
            "type": "string",
          },
          "limit": {
            "description": "Max results (default: 25)",
            "maximum": 500,
            "minimum": 1,
            "type": "integer",
          },
          "offset": {
            "description": "Pagination offset (default: 0)",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer",
          },
          "timeslotStart": {
            "description": "Timeslot start ISO timestamp from silpo_get_shopping_cart_by_id slot.start",
            "type": "string",
          },
        },
        "required": [
          "branchId",
          "deliveryType",
          "timeslotStart",
        ],
        "type": "object",
      },
