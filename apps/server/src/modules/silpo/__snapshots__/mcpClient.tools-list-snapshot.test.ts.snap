    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false,
      },
      "description": "Add or remove products from the user's favorites list.

Use productId and externalProductId from any product-returning tool (silpo_get_my_favorites, silpo_find_products_batch, silpo_get_products, silpo_get_similar_products, etc).

To ADD: set toDelete=false.
To REMOVE: set toDelete=true. Get productId and externalProductId from silpo_get_my_favorites.

Max 5 actions per call.",
      "execution": {
        "taskSupport": "forbidden",
      },
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "properties": {
          "actions": {
            "description": "List of add/remove actions (max 5)",
            "items": {
              "properties": {
                "externalProductId": {
                  "description": "externalProductId field from any product-returning tool",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer",
                },
                "productId": {
                  "description": "Product id field from any product-returning tool",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string",
                },
                "toDelete": {
                  "description": "true to remove from favorites, false to add",
                  "type": "boolean",
                },
              },
              "required": [
                "productId",
                "externalProductId",
                "toDelete",
              ],
              "type": "object",
            },
            "maxItems": 5,
            "minItems": 1,
            "type": "array",
          },
        },
        "required": [
          "actions",
        ],
        "type": "object",
      },
      "name": "silpo_add_or_update_favorite_products",
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "actions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "productId": {
                  "type": "string",
                },
                "toDelete": {
                  "type": "boolean",
                },
              },
              "required": [
                "productId",
                "toDelete",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "success": {
            "type": "boolean",
          },
          "summary": {
            "type": "string",
          },
        },
        "required": [
          "success",
          "summary",
          "actions",
        ],
        "type": "object",
      },
      "title": "Add/Update Favorite Products",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false,
      },
      "description": "Add or remove gift certificates from the shopping cart in one call. Adds run before removes.

certificatesToAdd: get barcode and pincode from silpo_get_my_certificates or from user input. Max 10.
certificatesToRemove: get barcode from the certificates array in silpo_get_shopping_cart_by_id response. Max 10.

MANDATORY: After calling this tool, ALWAYS call silpo_get_shopping_cart_by_id to verify the result and check if cart total changed.

VALIDATION ERRORS: If added[].validations is non-empty, show the messages to the user — the certificate was not applied.",
      "execution": {
        "taskSupport": "forbidden",
      },
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "properties": {
          "certificatesToAdd": {
            "description": "Certificates to add (barcode + optional pincode)",
            "items": {
              "properties": {
                "barcode": {
                  "description": "Certificate barcode",
                  "type": "string",
                },
                "pincode": {
                  "description": "Certificate PIN (required for gift certificates)",
                  "type": "string",
                },
              },
              "required": [
                "barcode",
              ],
              "type": "object",
            },
            "maxItems": 10,
            "type": "array",
          },
          "certificatesToRemove": {
            "description": "Certificates to remove (barcode from silpo_get_shopping_cart_by_id certificates)",
            "items": {
              "properties": {
                "barcode": {
                  "description": "Certificate barcode",
                  "type": "string",
                },
                "pincode": {
                  "description": "Certificate PIN (required for gift certificates)",
                  "type": "string",
                },
              },
              "required": [
                "barcode",
              ],
              "type": "object",
            },
            "maxItems": 10,
            "type": "array",
          },
          "shoppingCartId": {
            "description": "Cart ID from silpo_get_my_shopping_cart",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
        },
        "required": [
          "shoppingCartId",
        ],
        "type": "object",
      },
      "name": "silpo_add_or_update_certificates",
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "added": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "barcode": {
                  "type": "string",
                },
                "faceValue": {
                  "anyOf": [
                    {
                      "type": "number",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "validations": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "level": {
                        "type": "string",
                      },
                      "message": {
                        "type": "string",
                      },
                      "type": {
                        "type": "string",
                      },
                    },
                    "required": [
                      "type",
                      "level",
                      "message",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
              },
              "required": [
                "barcode",
                "faceValue",
                "validations",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "removed": {
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "success": {
            "type": "boolean",
          },
          "summary": {
            "type": "string",
          },
        },
        "required": [
          "success",
          "summary",
          "added",
          "removed",
        ],
        "type": "object",
      },
      "title": "Add/Remove Cart Certificates",
    },
  ],
}
`;
