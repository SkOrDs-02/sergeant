{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "in-process",
  "permissions": {
    "allow": [
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm format*)",
      "Bash(pnpm check)",
      "Bash(pnpm build*)",
      "Bash(pnpm --filter*)",
      "Bash(pnpm gen*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git stash list*)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(node scripts/*)",
      "Bash(node tools/*)",
      "Bash(tsx scripts/*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose config*)",
      "Agent"
    ],
    "deny": [
      "Bash(node -e*)",
      "Bash(node --eval*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git config *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(cat .env*)",
      "Bash(cat ~/.ssh/*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-hooks/block-protected-paths.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-hooks/guard-heavy-commands.mjs"
          }
        ]
      }
    ]
  }
}
