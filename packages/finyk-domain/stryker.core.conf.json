{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/domain/balanceReconciliation.ts",
    "src/domain/budget.ts",
    "src/domain/debtEngine.ts",
    "src/domain/monoCardDebt.ts",
    "src/domain/transferMatching.ts"
  ],
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/core/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/core/mutation-report.json"
  },
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 70
  },
  "timeoutMS": 10000,
  "concurrency": 2
}
