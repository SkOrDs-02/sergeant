{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // Кореневі ESLint-конфіги живуть ПОЗА воркспейсами (воркспейсні
  // `eslint.config.js` — лише реекспорт через `packageConfig("../..")`),
  // тож turbo їх не хешує за замовчуванням: зміна правила не інвалідувала
  // кеш `lint` і давала фальшивий зелений — локально і через remote cache
  // у CI. Доведено проб-прогоном: правило `max-lines: 1` для apps/web
  // лишало `17 cached, 17 total`, а `--force` того ж дерева падав.
  "globalDependencies": [
    "eslint.config.js",
    "eslint.baseline.js",
    "eslint.cross-surface.js",
    "eslint.landing.js",
    "eslint.mobile.js",
    "eslint.packages.js",
    "eslint.per-package.js",
    "eslint.server.js",
    "eslint.shell.js",
    "eslint.type-aware.js",
    "eslint.floating-promises-baseline.js",
    "eslint.web.js",
    ".prettierrc.json",
    ".prettierignore",
    "packages/eslint-plugin-sergeant-design/index.js"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".turbo/**"]
    },
    // `vite build` без VERCEL пише в `../server/dist` (поза пакетом web), тож
    // `dist/**` нічого не знімав, а кеш-хіт лишав порожній `apps/server/dist`
    // для `lint:pwa-precache` і size-limit. Без кешу web збирається щоразу.
    "@sergeant/web#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    // esbuild пише в `dist-server/`; `dist/**` для server = чужий web-бандл.
    "@sergeant/server#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist-server/**", ".turbo/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": [".eslintcache"]
    },
    // Ці два воркспейси не мають TS-джерел (`lint` = echo), тож
    // `.eslintcache` не створюють — без override turbo сипле
    // "no output files found" на кожному прогоні.
    "@sergeant/config#lint": {
      "outputs": []
    },
    "@sergeant/design-tokens#lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    // Guard-тести нижче читають файли поза власним пакетом, яких немає в його
    // графі залежностей: без явних `inputs` зламаний інваріант проходить
    // зеленим із кешу.
    "@sergeant/api-client#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/src/**",
        "$TURBO_ROOT$/apps/mobile/src/**"
      ],
      "outputs": []
    },
    "@sergeant/server#test": {
      "dependsOn": ["^build", "@sergeant/api-client#test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/telegram/**",
        "$TURBO_ROOT$/packages/api-client/pacts/**"
      ],
      "outputs": []
    },
    "@sergeant/web#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/product/whats-new/**",
        "$TURBO_ROOT$/vercel.json"
      ],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
